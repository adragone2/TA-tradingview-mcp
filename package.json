{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "test": "node scripts/run-tests.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:unit": "node scripts/run-tests.js",
    "test:all": "node scripts/run-tests.js --live",
    "test:verbose": "node --test --test-reporter=spec tests/e2e.test.js tests/pine_analyze.test.js",
    "test:backtest": "node --test tests/backtest.test.js",
    "test:strategy": "node --test tests/strategy.test.js",
    "test:patterns": "node --test tests/patterns.test.js",
    "test:breakout": "node --test tests/breakout.test.js",
    "test:context": "node --test tests/context.test.js",
    "test:wyckoff": "node --test tests/wyckoff.test.js",
    "test:liquidity": "node --test tests/liquidity.test.js tests/zones.test.js tests/risk.test.js tests/elliott.test.js tests/divergence.test.js tests/costs.test.js tests/mtf.test.js tests/synthetic.test.js tests/data_series.test.js",
    "test:channels": "node --test tests/channels.test.js",
    "test:pennants": "node --test tests/pennants.test.js tests/pattern_trades.test.js",
    "clear:orphans": "node scripts/clear-orphans.js",
    "noise:detectors": "node scripts/detector-noise.js",
    "noise:crabel": "node scripts/crabel-noise.js",
    "morning": "node scripts/morning-screen.js",
    "docs:screens": "node scripts/gen-screens-doc.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2",
    "dotenv": "^17.4.1"
  }
}
