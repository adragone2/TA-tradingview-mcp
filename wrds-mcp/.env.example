# WRDS credentials — copy to .env (which is git-ignored) and fill in.
# Never commit real credentials, and never paste them into a chat.

WRDS_USER=your_wrds_username
WRDS_PASSWORD=your_wrds_password

# Optional overrides — the defaults are correct for standard WRDS access.
# WRDS_HOST=wrds-pgdata.wharton.upenn.edu
# WRDS_PORT=9737
# WRDS_DB=wrds
# WRDS_STATEMENT_TIMEOUT_MS=120000
