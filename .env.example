# Tactical Alpha API — copy to .env (git-ignored) and fill in.
# Never commit a real key, and never paste one into a chat.

TA_API_KEY=your_ta_api_key_here

# Base URL. Defaults to the domain so requests go through nginx over TLS.
# TA_API_URL=https://tacticalalpha.io
# Direct to the VPS instead (no TLS): http://5.78.43.178:47892

# Alternative: point at an env file that already defines TA_API_KEY, so the
# key stays in one place instead of being copied here.
# TA_ENV_FILE=E:\path\to\existing\.env
